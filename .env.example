# Copy to .env.local and fill in. Never commit the filled-in file.
#
# WARNING: every variable prefixed NEXT_PUBLIC_ is compiled into the client
# bundle and is publicly readable. Never put a secret behind that prefix.

# --- Public (client bundle) -------------------------------------------------
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# --- Server only ------------------------------------------------------------
STROOP_RPC_URL=https://example.invalid
STROOP_REGISTRY_CONTRACT_ID=REPLACE_ME
