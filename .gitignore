*.dump
*.sql
*.bak
*.backup
*.tar
*.tar.gz
*.tgz
*.zip

# Logs
*.log
logs/
npm-debug.log*
yarn-error.log*

# Runtime and cache
tmp/
temp/
.cache/
.cache-loader/
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db

