# ---------------------------------------------------------------------------
# Anything committed to a public repository is permanently public, even if it
# is deleted later. Add to this file before you add the file it should exclude.
# ---------------------------------------------------------------------------

# Environment variables
.env
.env.*
!.env.example

# Secrets and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
*.mobileprovision
